# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# WhatsApp Cloud API (Optional for automated server-side dispatch; deep-link fallback works automatically)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
PARLOUR_WHATSAPP_NUMBER=919876543210

# Parlour Desk Admin Passcode (Optional; first-run setup in UI works if unset)
ADMIN_PASSCODE=
